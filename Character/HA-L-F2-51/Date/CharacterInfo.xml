<?xml version="1.0" encoding="UTF-8" ?>
<Character>
	<!-- Characterの名前 -->
	<Name>HA-L-F2-51</Name>

	<!-- TextBoxPosition 表示するCharacterのテキストボックスの位置 -->
	<!-- 0ならSpriteの上辺に表示される そこから縦方向にどのくらい離れているか -->
	<!-- デフォルトは0 -->
	<TextBoxPivot>30</TextBoxPivot>

	<!-- Characterのspriteの各種設定 -->
	<!-- SpriteにNormalが無い場合、例外を吐いて読み込み失敗になる -->
	<!-- SpriteSetting Sprite 設定するSprite -->
	<!-- Size 表示するCharacterのImageの大きさ デフォルトは256 -->
	<!-- Pivot_X 表示するCharacterの中心の位置のY座標 Size変更後のSpriteを参照 -->
	<!-- デフォルトはSpriteの横のサイズ / 2 -->
	<!-- Pivot_Y 表示するCharacterの中心の位置のX座標 Size変更後のSpriteを参照 -->
	<!-- デフォルトはSpriteの縦のサイズ -->
	<SpriteSettingList>
		<SpriteSetting Sprite="Normal">
			<Setting Size="600" Pivot_X="1072" Pivot_Y="1192" />
		</SpriteSetting>
		<SpriteSetting Sprite="Smile">
			<Setting Size="600" Pivot_X="1072" Pivot_Y="1192" />
		</SpriteSetting>
		<SpriteSetting Sprite="Emotionless">
			<Setting Size="600" Pivot_X="1072" Pivot_Y="1192" />
		</SpriteSetting>
	</SpriteSettingList>
</Character>